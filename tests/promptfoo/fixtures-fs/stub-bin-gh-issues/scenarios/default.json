    { "match": "issue create --help",
      "stdout": "Create an issue on GitHub.\n\nUSAGE\n  gh issue create [flags]\n\nFLAGS\n  -a, --assignee login       Assign people by their login\n  -b, --body string          Supply a body\n  -F, --body-file file       Read body text from file\n  -l, --label name           Add labels by name\n  -m, --milestone name       Add the issue to a milestone by name\n  -p, --project title        Add the issue to projects by title\n  -t, --title string         Supply a title\n      --type name            Set the issue type by name\n" },
    { "match": "issue edit --help",
      "stdout": "Edit one or more issues within the same repository.\n\nUSAGE\n  gh issue edit {<numbers> | <urls>} [flags]\n\nFLAGS\n      --add-assignee login       Add assigned users by their login\n      --add-blocked-by number    Mark the issue as blocked by another issue\n      --add-blocking number      Mark the issue as blocking another issue\n      --add-label name           Add labels by name\n      --add-project title        Add the issue to projects by title\n      --add-sub-issue number     Add a sub-issue\n  -b, --body string              Set the new body\n  -m, --milestone name           Edit the milestone the issue belongs to by name\n      --parent number            Set the parent issue\n      --remove-label name        Remove labels by name\n  -t, --title string             Set the new title\n" },
    { "match": "issue close --help",
      "stdout": "Close issue\n\nUSAGE\n  gh issue close {<number> | <url>} [flags]\n\nFLAGS\n  -c, --comment string       Leave a closing comment\n      --duplicate-of number  Close as a duplicate of another issue\n  -r, --reason string        Reason for closing: {completed|not planned}\n" },

