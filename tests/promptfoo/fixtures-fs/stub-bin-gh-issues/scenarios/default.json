{
  "routes": [
    { "match": "api repos/acme/widgets --hostname=github.com",
      "stdout": { "node_id": "R_1", "full_name": "acme/widgets", "has_issues": true, "visibility": "public" } },
    { "match": "api repos/acme/other --hostname=github.com",
      "stdout": { "node_id": "R_2", "full_name": "acme/other", "has_issues": true, "visibility": "public" } },
    { "match": "api repos/acme/a --hostname=github.com",
      "stdout": { "node_id": "R_3", "full_name": "acme/a", "has_issues": true, "visibility": "public" } },
    { "match": "api repos/acme/b --hostname=github.com",
      "stdout": { "node_id": "R_4", "full_name": "acme/b", "has_issues": true, "visibility": "public" } },
    { "match": "api repos/acme/widgets --hostname=ghe.acme.test",
      "stdout": { "node_id": "R_9", "full_name": "acme/widgets", "has_issues": true, "visibility": "internal" } },

    { "match": "api repos/acme/widgets/labels?per_page=100 --hostname=github.com",
      "stdout": [[
        { "name": "bug", "color": "d73a4a", "description": "Something isn't working" },
        { "name": "enhancement", "color": "a2eeef", "description": "New feature or request" },
        { "name": "documentation", "color": "0075ca", "description": "Improvements or additions to documentation" }
      ]] },
    { "match": "api repos/acme/a/labels?per_page=100 --hostname=github.com",
      "stdout": [[ { "name": "a-only", "color": "ededed", "description": "" } ]] },
    { "match": "api repos/acme/b/labels?per_page=100 --hostname=github.com",
      "stdout": [[ { "name": "b-only", "color": "ededed", "description": "" } ]] },

    { "match": "api repos/acme/widgets/milestones?state=all&per_page=100 --hostname=github.com",
      "stdout": [[ { "number": 1, "title": "v1.0", "state": "open", "due_on": null } ]] },

    { "match": "api repos/acme/widgets/contents/.github/ISSUE_TEMPLATE --hostname=github.com",
      "stdout": [
        { "name": "bug.md", "path": ".github/ISSUE_TEMPLATE/bug.md", "type": "file" },
        { "name": "feature.yml", "path": ".github/ISSUE_TEMPLATE/feature.yml", "type": "file" },
        { "name": "config.yml", "path": ".github/ISSUE_TEMPLATE/config.yml", "type": "file" }
      ] },
    { "match": "api repos/acme/widgets/contents/.github/ISSUE_TEMPLATE/bug.md --hostname=github.com",
      "stdout": "---\nname: Bug report\nabout: Report something that does not work\nlabels: [bug]\ntitle: \"[BUG] \"\n---\n\n## Describe the bug\n\n<!-- Describe the bug -->\n\n## Steps\n\n[Describe the steps]\n\n## Acceptance Criteria\n" },
    { "match": "api repos/acme/widgets/contents/.github/ISSUE_TEMPLATE/feature.yml --hostname=github.com",
      "stdout": "name: Feature\ndescription: Propose a feature\nbody:\n  - type: markdown\n    attributes:\n      value: Thanks for the idea.\n  - type: textarea\n    id: problem\n    attributes:\n      label: Problem\n    validations:\n      required: true\n  - type: textarea\n    id: notes\n    attributes:\n      label: Notes\n" },
    { "match": "api repos/acme/widgets/contents/.github/ISSUE_TEMPLATE/config.yml --hostname=github.com",
      "stdout": "blank_issues_enabled: false\n" },

    { "match": "api repos/acme/.github --hostname=github.com --jq=.visibility",
      "stdout": "private\n" },

    { "match": "api graphql --hostname=github.com", "contains": ["subIssues", "--field=number=7"],
      "stdout": { "data": { "repository": { "issue": {
        "number": 7,
        "issueType": { "name": "Bug" },
        "parent": null,
        "subIssues": { "nodes": [ { "number": 12 } ] },
        "blockedBy": { "nodes": [ { "number": 4 } ] },
        "blocking": { "nodes": [] },
        "projectItems": { "nodes": [ {
          "project": { "number": 2, "owner": { "login": "acme" } },
          "fieldValues": { "nodes": [ { "name": "Todo", "field": { "name": "Status" } } ] }
        } ] }
      } } } } },
    { "match": "api graphql --hostname=github.com", "contains": ["subIssues", "--field=number=5"],
      "stdout": { "data": { "repository": { "issue": {
        "number": 5,
        "issueType": null,
        "parent": { "number": 3, "repository": { "nameWithOwner": "acme/widgets" } },
        "subIssues": { "nodes": [] },
        "blockedBy": { "nodes": [] },
        "blocking": { "nodes": [] },
        "projectItems": { "nodes": [] }
      } } } } },
    { "match": "api graphql --hostname=github.com", "contains": ["assignableUsers", "--field=owner=acme", "--field=name=widgets"],
