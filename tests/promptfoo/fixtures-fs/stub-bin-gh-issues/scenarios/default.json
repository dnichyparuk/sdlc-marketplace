        "nodes": [ { "login": "alice", "name": "Alice A" }, { "login": "bob", "name": "Bob B" } ],
        "pageInfo": { "hasNextPage": false, "endCursor": null }
      } } } } },
    { "match": "api graphql --hostname=github.com", "contains": ["issueTypes", "--field=owner=acme"],
