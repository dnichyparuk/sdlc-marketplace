        { "id": "IT_1", "name": "Bug" }, { "id": "IT_2", "name": "Task" }
      ] } } } } },
    { "match": "api graphql --hostname=github.com", "contains": ["projectV2", "--field=owner=acme", "--field=number=2"],
      "stdout": { "data": { "repositoryOwner": { "projectV2": {
        "id": "PVT_2",
        "number": 2,
        "title": "Roadmap",
        "fields": { "nodes": [
          { "id": "PVTSSF_1", "name": "Status", "dataType": "SINGLE_SELECT", "options": [
