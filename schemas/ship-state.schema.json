{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rnagrodzki/sdlc-marketplace/main/schemas/ship-state.schema.json",
  "title": "Ship State",
  "description": "Validates .sdlc/execution/ship-*.json",
  "type": "object",
  "properties": {
    "paused": {"type":"object","properties":{"at":{"type":"string"},"reason":{"type":["string","null"]}},"required":["at"]},
    "version": {
      "const": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "branch": {
      "type": "string"
    },
    "flags": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "skip": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["execute", "commit", "review", "received-review", "commit-fixes", "version", "pr", "verify-pipeline", "await-remote-review"]
          }
        },
        "preset": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["A", "B", "C"]
            },
            {
              "type": "null"
            }
          ]
        },
        "bump": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["major", "minor", "patch"]
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "type": "boolean"
        },
        "planFile": {"oneOf":[{"type":"string"},{"type":"null"}]},
        "openspecContext": {"type":"object","properties":{"branchMatch":{},"isAlreadyArchived":{"type":"boolean"},"tasksDone":{"oneOf":[{"type":"integer"},{"type":"null"}]},"tasksTotal":{"oneOf":[{"type":"integer"},{"type":"null"}]}}},
        "sources": {"type":"object"},
        "ttlDays": {"type":"integer","minimum":0}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["execute", "commit", "review", "received-review", "commit-fixes", "version", "pr", "verify-pipeline", "await-remote-review", "verify-openspec", "archive-openspec", "learnings-commit"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "skipped", "failed"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "usage": {"type":"object","properties":{"inputTokens":{"type":"integer","minimum":0},"outputTokens":{"type":"integer","minimum":0},"cacheReadTokens":{"type":"integer","minimum":0},"cacheWriteTokens":{"type":"integer","minimum":0},"model":{"type":"string"},"effort":{"type":"string","enum":["low","medium","high","xhigh","max"]},"source":{"type":"string"}},"additionalProperties":false}
        },
        "required": ["name", "status"]
      }
    },
    "currentStep": { "oneOf": [ { "type": "string" }, { "type": "null" } ] },
    "history": { "type": "array", "items": { "type": "object", "properties": { "step": {"type":"string"}, "result": {"type":"string","enum":["success","failed","unknown"]}, "data": {}, "timestamp": {"type":"string"} }, "required": ["step","result","timestamp"] } },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        },
        "required": ["step", "decision"]
      }
    },
    "deferredFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["severity", "file", "title"]
      }
    }
  },
  "required": ["version", "startedAt", "branch", "flags", "steps"],
  "additionalProperties": false
}
